# Copy this file to .env and replace the values. Never commit .env, and never share it.
# Make a good random value with:  python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=change-me-use-a-long-random-value
# Letters and digits only (the value is placed inside a database address)
POSTGRES_PASSWORD=change-me-letters-and-digits-only

# "development" for http://localhost, "production" only behind https
FLASK_ENV=development

# Optional: a real address for password-reset emails
# PUBLIC_URL=https://your-app.example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
